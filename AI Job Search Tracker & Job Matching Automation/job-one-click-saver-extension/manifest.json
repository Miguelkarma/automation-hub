{
  "manifest_version": 3,
  "name": "Job One-Click Saver",
  "version": "1.0.0",
  "description": "Capture job pages and send them to n8n.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://n8n-miglearn.onrender.com/*"],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save Job",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  }
}
