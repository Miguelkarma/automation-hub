    {
      "parameters": {
        "jsCode": "const rawText = $json.content.parts[0].text;\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(rawText);\n} catch (error) {\n  throw new Error(\"AI returned invalid JSON: \" + error.message + \"\\nRaw text: \" + rawText);\n}\n\nconst jobUrl = (parsed.job_url || \"\").trim();\nconst normalizedUrl = jobUrl.toLowerCase();\n\nconst hasSpecificJobClue =\n  normalizedUrl.includes(\"/job/\") ||\n  normalizedUrl.includes(\"/jobs/\") ||\n  normalizedUrl.includes(\"jobs/view\") ||\n  normalizedUrl.includes(\"jk=\") ||\n  normalizedUrl.includes(\"jobid=\") ||\n  normalizedUrl.includes(\"job-id\") ||\n  normalizedUrl.includes(\"job_id\");\n\nconst genericUrls = [\n  \"https://ph.jobstreet.com/\",\n  \"https://www.jobstreet.com/\",\n  \"https://www.jobstreet.com.ph/\",\n  \"https://ph.indeed.com/\",\n  \"https://www.indeed.com/\",\n  \"https://www.linkedin.com/jobs/\",\n  \"https://www.onlinejobs.ph/\",\n];\n\nconst isGenericJobUrl =\n  !jobUrl ||\n  genericUrls.includes(normalizedUrl) ||\n  (\n    (\n      normalizedUrl.endsWith(\"jobstreet.com/\") ||\n      normalizedUrl.endsWith(\"indeed.com/\") ||\n      normalizedUrl.endsWith(\"linkedin.com/jobs/\") ||\n      normalizedUrl.endsWith(\"onlinejobs.ph/\")\n    ) &&\n    !hasSpecificJobClue\n  );\n\nreturn [\n  {\n    json: {\n      ...parsed,\n\n      is_reliable_job_url: !isGenericJobUrl,\n\n      matching_skills_text: Array.isArray(parsed.matching_skills)\n        ? parsed.matching_skills.join(\", \")\n        : parsed.matching_skills || \"\",\n\n      missing_skills_text: Array.isArray(parsed.missing_skills)\n        ? parsed.missing_skills.join(\", \")\n        : parsed.missing_skills || \"\",\n\n      red_flags_text: Array.isArray(parsed.red_flags)\n        ? parsed.red_flags.join(\", \")\n        : parsed.red_flags || \"\",\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
